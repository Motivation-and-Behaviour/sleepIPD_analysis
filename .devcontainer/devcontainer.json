{
	"name": "SleepIPD Analysis",
	"image": "ghcr.io/tarensanders/r-base:latest",
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
			"packages": "chron, dfoptim, future.apply, ggeffects, lubridate, mice, miceadds, optimx, papaja, purrr, readr, suncalc, TAM, webshot2",
			"installSystemRequirements": true
		}
	},
	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/rstudio/.claude,type=volume",
		"source=gh-config-${devcontainerId},target=/home/rstudio/.gh,type=volume"
	],
	"postCreateCommand": "sudo chown -R $(id -un):$(id -gn) $HOME/.claude",
	"shutdownAction": "none"
}